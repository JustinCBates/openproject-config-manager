#!/usr/bin/env python3
"""
Use Control Flow Engine to insert Discovery Prompt step into Phase 1.
This is a design-time tool - run once to update the control flow spec.
"""

import sys
from pathlib import Path

# Add control-flow to path
sys.path.insert(0, str(Path(__file__).parent.parent.parent / 'control-flow' / 'src'))

def main():
    """Insert discovery prompt step into Phase 1."""
    
    # Load control flow specification
    spec_file = Path(__file__).parent / 'control_flows.yml'
    
    print("=" * 70)
    print("🔧 Control Flow Engine: Inserting Discovery Prompt Step")
    print("=" * 70)
    print()
    
    # Read current spec
    import yaml
    with open(spec_file, 'r') as f:
        spec = yaml.safe_load(f)
    
    print(f"📋 Current Discovery Phase Steps:")
    discovery_phase = None
    for phase in spec['flows']['main_config_flow']['phases']:
        if phase['phase_id'] == 'discovery':
            discovery_phase = phase
            break
    
    if not discovery_phase:
        print("❌ Discovery phase not found!")
        return 1
    
    # Show current structure
    current_steps = discovery_phase.get('steps', [])
    if current_steps:
        for i, step in enumerate(current_steps):
            print(f"  {i}. {step.get('step_id', 'unknown')} - {step.get('name', 'Unknown')}")
    else:
        print("  (No steps defined - will create steps array)")
    
    print()
    print("🆕 Inserting new step:")
    print("  → Step ID: discovery_prompt")
    print("  → Name: Discovery Configuration Prompt")
    print("  → Position: Beginning of phase (Step 0)")
    print("  → Type: Interactive TUI Form")
    print()
    
    # Define the new step
    new_step = {
        'step_id': 'discovery_prompt',
        'name': 'Discovery Configuration Prompt',
        'status': 'PLANNED',  # Start as PLANNED
        'description': 'Ask user whether to use automatic system discovery',
        'type': 'interactive',
        'implementation': {
            'step_directory': 'phases/phase_1_discovery/step_0_discovery_prompt/',
            'module': 'phases.phase_1_discovery.step_0_discovery_prompt.discovery_prompt',
            'function': 'execute_discovery_prompt(context, phase_dir)',
            'returns': 'Dict with use_discovery, discovery_scope, discovery_config',
            'tui_form': 'phases/phase_1_discovery/step_0_discovery_prompt/discovery_prompt.layout.yml',
        },
        'artifacts_produced': [
            'use_discovery',
            'discovery_scope', 
            'discovery_config'
        ],
        'artifacts_consumed': [],
        'sequence': 0
    }
    
    # Insert at beginning
    if 'steps' not in discovery_phase:
        discovery_phase['steps'] = []
    
    discovery_phase['steps'].insert(0, new_step)
    
    # Update sequence numbers for existing steps
    for i, step in enumerate(discovery_phase['steps']):
        step['sequence'] = i
    
    # Mark existing steps as conditional
    for step in discovery_phase['steps'][1:]:  # Skip the new step
        if step['step_id'] in ['env_discovery', 'system_discovery']:
            step['conditional'] = 'discovery_config.run_' + step['step_id']
    
    # Save updated spec
    with open(spec_file, 'w') as f:
        yaml.dump(spec, f, default_flow_style=False, sort_keys=False, indent=2)
    
    print("✅ Control flow specification updated!")
    print(f"   File: {spec_file}")
    print()
    print("📋 Updated Discovery Phase Steps:")
    for i, step in enumerate(discovery_phase['steps']):
        conditional = f" (conditional: {step.get('conditional', 'N/A')})" if 'conditional' in step else ""
        print(f"  {i}. {step.get('step_id')} - {step.get('name')}{conditional}")
    print()
    print("🎯 Next Steps:")
    print("  1. Review the updated control_flows.yml")
    print("  2. Create directory: phases/phase_1_discovery/step_0_discovery_prompt/")
    print("  3. Create TUI form: discovery_prompt.layout.yml")
    print("  4. Implement Python logic: discovery_prompt.py")
    print("  5. Update orchestrator to call the new step")
    print()
    
    return 0


if __name__ == '__main__':
    exit(main())
