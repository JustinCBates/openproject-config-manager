# OpenProject Configuration File Format Specification
# This file defines the .cfg format produced by Configuration Manager
# and consumed by Deployment Manager

## Configuration File: interactive_config.cfg

# =============================================================================
# CORE OPENPROJECT CONFIGURATION
# =============================================================================

# Application Configuration
TAG="16-slim"
OPENPROJECT_TAG="16-slim"
OPENPROJECT_HOST__NAME="myproject.example.com"
DOMAIN_NAME="myproject.example.com"
OPENPROJECT_RAILS__RELATIVE__URL__ROOT="/openproject"

# Network and Port Configuration
OPENPROJECT_HTTPS="true"
OPENPROJECT_HSTS="true"
PORT="8080"
HTTPS_PORT="8443"

# SSL Configuration
SSL_EMAIL="admin@example.com"
SSL_CERT_PATH="/etc/ssl/certs/"
SSL_KEY_PATH="/etc/ssl/private/"

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Settings
DATABASE_URL="postgres://postgres:secure_password@db/openproject?pool=20&encoding=unicode&reconnect=true"
POSTGRES_PASSWORD="secure_password"
PGDATA="/var/lib/postgresql/data"

# Performance Tuning
RAILS_MIN_THREADS="4"
RAILS_MAX_THREADS="16"

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================

# OpenProject Data Storage
OPDATA="/var/openproject/assets"
BACKUP_PATH="/var/openproject/backups"

# =============================================================================
# PROXY AND TEMPLATE CONFIGURATION
# =============================================================================

# Proxy Configuration
PROXY_TYPE="caddy"
REVERSE_PROXY_HOST="web"
REVERSE_PROXY_PORT="8080"

# Security Settings
SECURITY_HEADERS_ENABLED="true"
RATE_LIMITING_ENABLED="true"
RATE_LIMIT_EVENTS="100"
RATE_LIMIT_WINDOW="1m"
REDIRECT_HTTP_TO_HTTPS="true"

# =============================================================================
# ENVIRONMENT AND DISCOVERY VARIABLES
# =============================================================================

# Auto-discovered by Configuration Manager
DISCOVERED_OS="ubuntu"
DISCOVERED_DOCKER_VERSION="24.0.5"
DISCOVERED_EXTERNAL_IP="203.0.113.42"
DISCOVERED_INTERNAL_IP="192.168.1.100"
AVAILABLE_PORTS="80,443,8080,8443"

# =============================================================================
# DEPLOYMENT SETTINGS
# =============================================================================

# Deployment Behavior
PULL_IMAGES="true"
HEALTH_CHECK_TIMEOUT="300"
PROBER_ENABLED="true"
DRY_RUN="false"

# =============================================================================
# OPTIONAL FEATURES
# =============================================================================

# Email Configuration
IMAP_ENABLED="false"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USERNAME="openproject@example.com"
SMTP_PASSWORD="smtp_password"

# Advanced Configuration
MEMCACHE_SERVER="cache:11211"
MONITORING_ENABLED="true"
LOG_LEVEL="info"

# =============================================================================
# CONFIGURATION METADATA
# =============================================================================

# Generated by Configuration Manager
CONFIG_VERSION="1.0"
CONFIG_GENERATED_AT="2025-10-12T14:30:00Z"
CONFIG_GENERATED_BY="openproject-config-manager"
CONFIG_ENVIRONMENT="production"