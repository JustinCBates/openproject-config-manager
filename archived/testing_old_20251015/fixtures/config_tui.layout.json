{
    "project_name": "my-openproject",
    "environment_type": "production",
    "admin_email": "admin@example.com",
    "admin_password": "SecurePassword123!",
    "database_type": "postgresql",
    "database_setup": "container",
    "domain_name": "openproject.example.com",
    "ssl_configuration": "letsencrypt",
    "https_port": "443",
    "letsencrypt_email": "admin@example.com",
    "enable_email": true,
    "email_delivery_method": "smtp",
    "smtp_host": "smtp.example.com",
    "smtp_port": "587",
    "smtp_encryption": "starttls",
    "smtp_username": "openproject@example.com",
    "smtp_password": "EmailPassword123!",
    "smtp_from_address": "openproject@example.com",
    "enable_attachments": true,
    "attachment_max_size": "100",
    "attachment_storage_path": "/var/openproject/files",
    "enable_repositories": true,
    "git_support": true,
    "subversion_support": false,
    "memory_limit": "8g",
    "worker_processes": "6",
    "enable_backups": true,
    "backup_frequency": "daily",
    "backup_retention": "30",
    "log_level": "warn",
    "enable_metrics": true
}